<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
	  <TargetFrameworks>net462;net47;net48;net10.0</TargetFrameworks>
	  <TargetFrameworks Condition="'$(OS)' != 'Windows_NT'">net10.0</TargetFrameworks>


	  <IsPackable>false</IsPackable>


	  <SignAssembly>True</SignAssembly>
	  <SignAssembly Condition="'$(OS)' != 'Windows_NT'">false</SignAssembly>

	  <AssemblyOriginatorKeyFile>..\Gnu.Getopt.snk</AssemblyOriginatorKeyFile>
