<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFrameworks>net462;net47;net48;net8.0</TargetFrameworks>
		<TargetFrameworks Condition="'$(OS)' != 'Windows_NT'">net8.0</TargetFrameworks>
		<ImplicitUsings>disable</ImplicitUsings>
		<SignAssembly>True</SignAssembly>
		<SignAssembly Condition="'$(OS)' != 'Windows_NT'">false</SignAssembly>
		<AssemblyOriginatorKeyFile>..\Gnu.Getopt.snk</AssemblyOriginatorKeyFile>

	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\Gnu.Getopt\Gnu.Getopt.csproj" />
  </ItemGroup>

</Project>
